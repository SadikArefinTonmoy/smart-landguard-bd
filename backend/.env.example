# Local, demo-only. DO NOT expose this server on the public Internet.
LANDGUARD_ENV=development
LANDGUARD_DATABASE_MODE=postgresql
DATABASE_URL=postgresql://landguard_demo:CHANGE_ME_PASSWORD@localhost:5432/landguard_demo
LANDGUARD_ALLOWED_ORIGINS=http://localhost:4173,http://127.0.0.1:4173
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
LANDGUARD_SECRET_KEY=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LANDGUARD_FILE_ENCRYPTION_KEY=REPLACE_WITH_OWN_FERNET_KEY
